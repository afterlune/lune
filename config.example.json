{
  "models": {
    "providers": {
      "deepseek": {
        "protocol": "responses",
        "baseURL": "https://api.deepseek.com",
        "apiKey": ""
      },
      "openai-responses": {
        "protocol": "responses",
        "baseURL": "https://api.openai.com/v1",
        "apiKey": "",
        "serverCompaction": true
      },
      "anthropic": {
        "protocol": "anthropic-messages",
        "baseURL": "https://api.anthropic.com",
        "apiKey": ""
      }
    },
    "profiles": {
      "deepseek-flash": {
        "provider": "deepseek",
        "model": "deepseek-chat",
        "displayName": "DeepSeek V3"
      },
      "openai-model": {
        "provider": "openai-responses",
        "model": "gpt-5",
        "displayName": "GPT-5"
      },
      "anthropic-model": {
        "provider": "anthropic",
        "model": "claude-3-7-sonnet-20250219",
        "displayName": "Claude 3.7 Sonnet",
        "maxOutputTokens": 8192
      }
    },
    "defaultProfile": "deepseek-flash"
  },
  "runtime": {
    "maxParallelAgents": 4,
    "maxTeamChildrenPerAgent": 4,
    "maxTeamDepth": 2,
    "contextWindow": 0,
    "autoCompact": true,
    "autoCompactThreshold": 0.8,
    "reserveOutputTokens": 0
  },
  "attachments": {
    "maxFiles": 0,
    "maxFileBytes": 0,
    "maxTotalBytes": 0
  },
  "mcpServers": {}
}
