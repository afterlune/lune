# Generate a random value of at least 32 characters. Keep this file local.
LUNE_A2A_TOKEN=
LUNE_WEB_TOKEN=

# The Linux container uses its own provider config; Windows DPAPI keys are not reusable here.
LUNE_DEEPSEEK_API_KEY=

# Windows Docker Desktop bind mount for the Lune workspace.
LUNE_WORKSPACE_PATH=D:/WorkSpace
